# 必填：生产环境请从密钥管理服务注入，不要提交真实密码。
DATABASE_URL=postgres://lgp:lgp@127.0.0.1:5432/postgres

# 连接池标识和容量；总连接数要按“实例数 × PG_POOL_MAX”计算。
PG_APPLICATION_NAME=nest-pg
PG_POOL_MIN=2
PG_POOL_MAX=20

# 所有时间单位均为毫秒。
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_QUERY_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=10000
PG_SLOW_QUERY_MS=500

# 线上数据库建议启用 SSL；私有 CA 可通过 PG_SSL_CA 注入。
PG_SSL=false
PG_SSL_REJECT_UNAUTHORIZED=true

PORT=3000
