{
    "extends": "../../../tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "incremental": true,
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "noEmit": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "types": ["node", "react", "react-dom"],
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "jsx": "preserve"
    },
    "include": ["next-env.d.ts", ".next/types/**/*.ts", "src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules"]
}
