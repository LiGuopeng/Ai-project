{
    "name": "todo-list-demo",
    "version": "1.0.0",
    "private": true,
    "packageManager": "pnpm@9.12.2",
    "scripts": {
        "build": "turbo build",
        "dev": "turbo dev",
        "dev:db": "docker compose -p todo-list -f .devcontainer/docker-compose.yml up -d",
        "stop:db": "docker compose -p todo-list -f .devcontainer/docker-compose.yml down",
        "typecheck": "turbo typecheck",
        "lint": "eslint .",
        "format": "prettier --write .",
        "clean": "rimraf **/dist **/build .turbo"
    },
    "devDependencies": {
        "@eslint/js": "9.14.0",
        "@types/node": "22.9.0",
        "eslint": "9.14.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-react-hooks": "5.1.0",
        "eslint-plugin-react-refresh": "0.4.14",
        "globals": "15.12.0",
        "prettier": "3.3.3",
        "rimraf": "6.0.1",
        "turbo": "2.2.3",
        "typescript": "5.6.3",
        "typescript-eslint": "8.13.0"
    }
}
