{
    "name": "todo-app",
    "version": "1.0.0",
    "description": "类 Notion 风格的协同 Todo 应用（基于妙码Docs工程规范搭建）",
    "private": true,
    "packageManager": "pnpm@9.12.3",
    "scripts": {
        "build": "turbo build",
        "build:watch": "turbo build:watch",
        "dev": "turbo dev",
        "dev:server": "pnpm --filter @todo-app/server start:dev",
        "dev:web": "pnpm --filter @todo-app/web dev",
        "docker:start": "docker compose -p todo-app -f .devcontainer/docker-compose.yml up -d",
        "docker:stop": "docker compose -p todo-app -f .devcontainer/docker-compose.yml down",
        "clean": "run-s clean:build clean:caches",
        "clean:build": "pnpm --filter @todo-app/* clean",
        "clean:caches": "rimraf .turbo/cache **/*/.turbo",
        "lint": "eslint",
        "lint:staged": "lint-staged",
        "spellcheck": "cspell lint --dot --gitignore --color --cache --show-suggestions \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
        "typecheck": "turbo typecheck",
        "commit": "git-cz",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{md,json}": ["prettier --cache --write --no-error-on-unmatched-pattern"],
        "*.{css,less}": ["prettier --cache --write"],
        "*.{js,jsx}": ["eslint --fix", "prettier --cache --write"],
        "*.{ts,tsx}": ["eslint --fix", "prettier --cache --parser=typescript --write"]
    },
    "devDependencies": {
        "@commitlint/cli": "19.5.0",
        "@commitlint/config-conventional": "19.5.0",
        "@eslint/js": "9.14.0",
        "@types/node": "22.9.0",
        "commitizen": "4.3.1",
        "cspell": "8.15.7",
        "cz-git": "1.10.1",
        "eslint": "9.14.0",
        "eslint-plugin-prettier": "5.2.1",
        "eslint-plugin-react-hooks": "5.1.0",
        "eslint-plugin-react-refresh": "0.4.14",
        "eslint-plugin-simple-import-sort": "12.1.1",
        "fast-glob": "3.3.2",
        "globals": "15.12.0",
        "husky": "9.1.6",
        "lint-staged": "15.2.10",
        "npm-run-all2": "7.0.1",
        "prettier": "3.3.3",
        "rimraf": "6.0.1",
        "tsup": "8.3.5",
        "turbo": "2.2.3",
        "typescript": "5.6.3",
        "typescript-eslint": "8.13.0"
    }
}
